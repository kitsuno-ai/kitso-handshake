{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitsuno.ai/handshake/v0.1/vacancy-agent-card.json",
  "title": "Kitso Handshake v0.1 — Vacancy Agent Card extension",
  "description": "Schema for the kitso.handshake.v1 extension key on an A2A AgentCard representing a hiring entity (direct or via RPO/intermediary). Validates the wrapper object containing the kitso.handshake.v1 key.",
  "type": "object",
  "required": ["kitso.handshake.v1"],
  "properties": {
    "kitso.handshake.v1": {
      "type": "object",
      "required": ["principal_type", "vacancy", "consent_policy", "provenance"],
      "properties": {
        "principal_type": {
          "type": "string",
          "enum": ["hiring_entity", "rpo", "internal_mobility_platform"]
        },
        "vacancy": {
          "type": "object",
          "required": ["role_title", "role_family", "employment_type", "ttl"],
          "properties": {
            "role_title": { "type": "string" },
            "role_family": { "type": "string" },
            "seniority": { "type": "string" },
            "employment_type": { "$ref": "common.json#/$defs/EmploymentType" },
            "geography": { "$ref": "common.json#/$defs/Geography" },
            "compensation": {
              "type": "object",
              "required": ["disclosed_in_invitation"],
              "properties": {
                "disclosed_in_invitation": {
                  "type": "boolean",
                  "description": "Whether compensation is revealed at invitation time or held back behind a disclosure trigger."
                },
                "range": {
                  "type": "object",
                  "required": ["currency"],
                  "properties": {
                    "min": { "type": "number", "minimum": 0 },
                    "max": { "type": "number", "minimum": 0 },
                    "currency": { "$ref": "common.json#/$defs/IsoCurrencyCode" },
                    "period": {
                      "type": "string",
                      "enum": ["hour", "day", "month", "year", "project", "one_time"]
                    }
                  },
                  "additionalProperties": false
                },
                "disclosure_trigger": {
                  "type": "string",
                  "examples": ["after_seeker_accepts_invitation", "after_first_call"]
                }
              },
              "additionalProperties": false
            },
            "must_haves": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            },
            "nice_to_haves": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            },
            "ttl": { "$ref": "common.json#/$defs/IsoDateTime" }
          },
          "additionalProperties": false
        },
        "hiring_entity": {
          "type": "object",
          "description": "Identity of the actual hiring entity. May be partly or fully withheld behind a disclosure trigger. The RPO case (§7.2) uses the represented_via_rpo branch.",
          "properties": {
            "name_disclosed_in_invitation": { "type": "boolean" },
            "name": { "type": "string" },
            "industry": { "type": "string" },
            "size_band": {
              "type": "string",
              "examples": ["1-10", "11-50", "51-200", "201-500", "501-1000", "1000+"]
            },
            "disclosure_trigger": { "type": "string" },
            "represented_via_rpo": { "type": "boolean" },
            "rpo_name": { "type": "string" },
            "underlying_entity_disclosed": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "consent_policy": {
          "type": "object",
          "required": ["agent_may_invite_without_human_review"],
          "properties": {
            "agent_may_invite_without_human_review": { "type": "boolean" },
            "human_in_loop_role": {
              "type": "string",
              "examples": ["hiring_manager", "recruiter", "rpo_owner"]
            }
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "required": ["tier"],
          "properties": {
            "tier": { "$ref": "common.json#/$defs/TrustTier" },
            "domain": { "type": "string", "format": "hostname" },
            "agent_dns": {
              "type": "string",
              "description": "Agent DNS name in the .agent namespace, e.g., acme.agent."
            },
            "original_source": {
              "type": "string",
              "format": "uri",
              "description": "Required when tier is third_party_attested — link to the original public source."
            },
            "attested_by": { "$ref": "common.json#/$defs/AgentIdentifier" }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": { "properties": { "tier": { "const": "third_party_attested" } } },
              "then": { "required": ["original_source", "attested_by"] }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
