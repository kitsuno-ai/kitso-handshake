{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitsuno.ai/handshake/v0.1/common.json",
  "title": "Kitso Handshake v0.1 — common types",
  "description": "Shared enums and reusable types referenced by the other v0.1 schemas. Not a standalone payload.",
  "type": "object",
  "$defs": {
    "ConsentTier": {
      "title": "Consent tier",
      "description": "The four-tier classification from the consent grammar annex (§5).",
      "type": "string",
      "enum": [
        "auto_disclosable",
        "confirmation_required",
        "human_only",
        "forbidden"
      ]
    },
    "TrustTier": {
      "title": "Trust tier",
      "description": "The five-tier hierarchy from the trust-tiers annex (§6).",
      "type": "string",
      "enum": [
        "domain_verified",
        "agent_resolved",
        "third_party_attested",
        "self_asserted",
        "anonymous"
      ]
    },
    "EmploymentType": {
      "title": "Employment type",
      "description": "Open enum — implementations may extend with their own values; the listed values are the canonical set for v0.1.",
      "type": "string",
      "examples": [
        "permanent",
        "contract",
        "temporary",
        "internship",
        "apprenticeship",
        "freelance"
      ]
    },
    "PrincipalDecision": {
      "title": "Principal decision on an invitation",
      "type": "string",
      "enum": [
        "accept",
        "decline",
        "request_more_information",
        "propose_alternative_terms"
      ]
    },
    "AgentIdentifier": {
      "title": "Agent identifier",
      "description": "Stable agent identifier, recommended pattern scheme:identifier (e.g., 'kitsuno.agent/u/<id>' or '<domain>.agent/v/<id>').",
      "type": "string",
      "minLength": 1,
      "examples": [
        "kitsuno.agent/u/seeker_xyz",
        "acme.agent/v/eng-42",
        "kitsuno.agent/synthesized/tg_dachtech/abc123"
      ]
    },
    "IsoDateTime": {
      "title": "RFC 3339 / ISO 8601 date-time",
      "type": "string",
      "format": "date-time"
    },
    "IsoCountryCode": {
      "title": "ISO 3166-1 alpha-2 country code",
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "IsoLanguageCode": {
      "title": "ISO 639-1 two-letter language code",
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "IsoCurrencyCode": {
      "title": "ISO 4217 three-letter currency code",
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "Money": {
      "title": "Money amount with currency and period",
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "$ref": "#/$defs/IsoCurrencyCode" },
        "period": {
          "type": "string",
          "enum": ["hour", "day", "month", "year", "project", "one_time"]
        }
      },
      "additionalProperties": false
    },
    "Geographies": {
      "title": "Geographic scope (used in SeekerAgentCard)",
      "type": "object",
      "properties": {
        "countries": {
          "type": "array",
          "items": { "$ref": "#/$defs/IsoCountryCode" },
          "uniqueItems": true
        },
        "remote_ok": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "Geography": {
      "title": "Single geographic location (used in VacancyAgentCard)",
      "type": "object",
      "required": ["country"],
      "properties": {
        "country": { "$ref": "#/$defs/IsoCountryCode" },
        "city": { "type": "string" },
        "remote_policy": {
          "type": "string",
          "examples": [
            "fully_remote",
            "hybrid_3_days",
            "hybrid_2_days",
            "on_site"
          ]
        }
      },
      "additionalProperties": false
    },
    "LanguageProficiency": {
      "title": "Language and CEFR-style proficiency level",
      "type": "object",
      "required": ["language", "level"],
      "properties": {
        "language": { "$ref": "#/$defs/IsoLanguageCode" },
        "level": {
          "type": "string",
          "enum": ["A1", "A2", "B1", "B2", "C1", "C2", "native"]
        }
      },
      "additionalProperties": false
    },
    "Authorization": {
      "title": "Authorization envelope (consent grammar §5)",
      "description": "Every authorization granted by a principal to an agent carries these fields. Standing authorizations without expiry are forbidden by the protocol.",
      "type": "object",
      "required": ["granted_at", "expires_at", "scope", "revocable"],
      "properties": {
        "granted_at": { "$ref": "#/$defs/IsoDateTime" },
        "expires_at": { "$ref": "#/$defs/IsoDateTime" },
        "scope": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Specific Tasks or fields the authorization covers."
        },
        "revocable": {
          "type": "boolean",
          "const": true,
          "description": "Always true. Revocation MUST be respected within 60 seconds of receipt."
        },
        "bindability": {
          "type": "string",
          "enum": ["may_bind", "negotiate_and_surface_only"],
          "description": "Whether the authorization permits the agent to commit on the principal's behalf, or only to negotiate-and-surface."
        }
      },
      "additionalProperties": false
    }
  }
}
